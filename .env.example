# =========================================================================
# BEACON Tourist Safety & Incident Response — Environment Variables Example
# =========================================================================

# Supabase Public Configuration (Client-side / Browser & Server)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"

# Server-Side Supabase Configuration (Optional / Nitro Server runtime)
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"
SUPABASE_URL="https://your_supabase_project_id.supabase.co"

# Supabase Edge Functions Secret Role Key (Only in Supabase dashboard / Edge runtime)
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# CrowdX (Chennai Crowd Watch) Vision Pipeline (Optional / Defaults to localhost:8000)
# VITE_CROWDX_API_URL="http://localhost:8000"
# VITE_CROWDX_WS_URL="ws://localhost:8000"
